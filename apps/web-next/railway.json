{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=web-next"
  },
  "deploy": {
    "startCommand": "pnpm --filter web-next start",
    "healthcheckPath": "/payments",
    "restartPolicyType": "ON_FAILURE"
  }
}
