{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=web-angular"
  },
  "deploy": {
    "startCommand": "npx --yes serve@14.2.8 -s apps/web-angular/dist/web-angular/browser -l tcp://0.0.0.0:$PORT",
    "healthcheckPath": "/payments",
    "restartPolicyType": "ON_FAILURE"
  }
}
